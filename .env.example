# Ключ Anthropic API (https://console.anthropic.com). Без него сервис работает в демо-режиме.
ANTHROPIC_API_KEY=

# Модель, которая анализирует бизнес и пишет сайт (по умолчанию claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Глубина «раздумий» модели: low | medium | high  (по умолчанию medium)
# ANTHROPIC_EFFORT=medium

# Порт сервера
# PORT=3000

# Сколько генераций в час разрешено с одного IP (защита вашего бюджета)
# RATE_LIMIT_PER_HOUR=10

# Если сервис стоит за nginx/Cloudflare/Heroku и т.п. — поставьте 1, чтобы лимит считался по реальному IP
# TRUST_PROXY=0

# Папка для сохранённых сайтов
# DATA_DIR=./data
